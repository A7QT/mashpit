#!/usr/bin/env python3
"""mashpit CLI — validate + render + analyze + edit + snippet + qc + undo.

Usage:
    agent/mashpit validate <arrangement.json> [--quiet]
    agent/mashpit render <arrangement.json> [--tier preview|full] [--out FILE]
    agent/mashpit analyze <audio> [--out sidecar.json]
    agent/mashpit edit <arrangement.json> --op match_bpm|smooth [opts]
    agent/mashpit snippet <arrangement.json> --from-sec A --to-sec B
    agent/mashpit qc <render.wav>
    agent/mashpit undo <arrangement.json>
"""
import json
import math
import os
import subprocess
import sys

TEMPO_LO, TEMPO_HI = 0.92, 1.08
PITCH_MAX = 6
ENGINE_SR = 44100


def err(msg, hint):
    return ("error", f"{msg}  -> fix: {hint}")


def check_schema(doc):
    problems = []
    if not isinstance(doc, dict):
        return [err("top level must be an object", "wrap the arrangement in {...}")]
    for key in ("version", "projectBpm", "tracks", "clips", "mix"):
        if key not in doc:
            problems.append(err(f"missing required key '{key}'", f"add \"{key}\" (see spec/mashup.schema.json)"))
    if doc.get("version") != 1:
        problems.append(err(f"unsupported version {doc.get('version')!r}", "set \"version\": 1"))
    bpm = doc.get("projectBpm")
    if not isinstance(bpm, (int, float)) or not 60 <= bpm <= 200:
        problems.append(err(f"projectBpm {bpm!r} out of range", "pick 60..200"))
    for name in ("tracks", "clips", "mix"):
        if name in doc and not isinstance(doc[name], list):
            problems.append(err(f"'{name}' must be an array", f"make \"{name}\" a [...] list"))
    return problems


def validate(doc):
    problems = check_schema(doc)
    if problems:
        return problems
    tracks = {t["id"]: t for t in doc["tracks"] if isinstance(t, dict) and "id" in t}
    if len(tracks) != len(doc["tracks"]):
        problems.append(err("duplicate or id-less track", "give every track a unique string id"))
    for i, clip in enumerate(doc["clips"]):
        where = f"clips[{i}]"
        tid = clip.get("track")
        if tid not in tracks:
            problems.append(err(f"{where} references unknown track '{tid}'",
                                f"add it to \"tracks\" or point at one of {sorted(tracks)}"))
        for key in ("atBar", "bars"):
            v = clip.get(key)
            if not isinstance(v, (int, float)) or v < 1:
                problems.append(err(f"{where}.{key}={v!r} invalid", "use a number >= 1"))
        ps = clip.get("pitchSemi", 0)
        if not isinstance(ps, int) or abs(ps) > PITCH_MAX:
            problems.append(err(f"{where}.pitchSemi={ps!r} beyond +-6",
                                "keep within +-6 semitones (TUNABLE limit, see ARCHITECTURE.md)"))
        tr = clip.get("tempoRatio", 1.0)
        if not isinstance(tr, (int, float)) or not TEMPO_LO <= tr <= TEMPO_HI:
            problems.append(err(f"{where}.tempoRatio={tr!r} beyond +-8%",
                                "enable keylock or pull toward 1.0 (TUNABLE limit)"))
    # same-track overlap
    by_track = {}
    for clip in doc["clips"]:
        by_track.setdefault(clip.get("track"), []).append(clip)
    for tid, clips in by_track.items():
        segs = sorted((c.get("atBar", 0), c.get("atBar", 0) + c.get("bars", 0)) for c in clips)
        for (s1, e1), (s2, e2) in zip(segs, segs[1:]):
            if s2 < e1:
                problems.append(err(f"clips overlap on track '{tid}' (bar {s2} inside {s1}-{e1})",
                                    "move one clip — one deck plays one clip at a time"))
    # xfade needs overlapping clips
    for j, mx in enumerate(doc["mix"]):
        s, e = mx.get("atBar", 0), mx.get("atBar", 0) + mx.get("bars", 0)
        overlaps = [tid for tid, clips in by_track.items()
                    if any(c.get("atBar", 0) < e and s < c.get("atBar", 0) + c.get("bars", 0)
                           for c in clips)]
        if len(overlaps) < 2:
            problems.append(err(f"mix[{j}] @bar {s} has no 2-clip overlap to blend",
                                "slide clips so two overlap inside the xfade, or move the xfade"))
        eq = mx.get("eq", {})
        for band in ("low", "mid", "high"):
            if band in eq and not -12 <= eq[band] <= 12:
                problems.append(err(f"mix[{j}].eq.{band}={eq[band]!r} out of range",
                                    "keep EQ within +-12 dB"))
    return problems


def load_doc(path):
    try:
        with open(path) as fh:
            return json.load(fh), None
    except FileNotFoundError:
        return None, f"no such file: {path}"
    except json.JSONDecodeError as exc:
        return None, f"invalid JSON in {path}: {exc}"


def sidecar_for(audio_path):
    """Sidecar convention: <audio>.analysis.json next to the file."""
    import glob
    cands = [audio_path + ".analysis.json"]
    base, _ = os.path.splitext(audio_path)
    cands.append(base + ".analysis.json")
    for c in cands:
        if os.path.isfile(c):
            with open(c) as fh:
                return json.load(fh), None
    return None, (f"no sidecar for {audio_path} "
                  "(run: agent/mashpit analyze <audio> first)")


def cmd_validate(argv):
    if len(argv) < 3:
        print("usage: agent/mashpit validate <arrangement.json> [--quiet]")
        return 2
    path, quiet = argv[2], "--quiet" in argv
    doc, error = load_doc(path)
    if error:
        print(error)
        return 2
    problems = validate(doc)
    if not problems:
        if not quiet:
            clips = len(doc["clips"])
            print(f"valid: {path} ({clips} clips @ {doc['projectBpm']}bpm)")
        return 0
    if not quiet:
        print(f"invalid: {path} ({len(problems)} problems)")
        for kind, msg in problems:
            print(f"  [{kind}] {msg}")
    return 1


def sec_per_bar(bpm):
    return 60.0 / bpm * 4.0


def cmd_analyze(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="agent/mashpit analyze")
    ap.add_argument("audio")
    ap.add_argument("--out", default=None)
    ap.add_argument("--analyzer", default=os.environ.get("MASHPT_ANALYZER"))
    ns = ap.parse_args(argv[2:])
    if not ns.analyzer or not os.path.isfile(ns.analyzer):
        print("need the analyzer binary: set MASHPT_ANALYZER "
              "(glue/analyze.cpp -> mashpit-analyze)")
        return 2
    if not os.path.isfile(ns.audio):
        print(f"no such file: {ns.audio}")
        return 2
    out = ns.out or (ns.audio + ".analysis.json")
    env = dict(os.environ)
    env["QT_QPA_PLATFORM"] = "offscreen"
    cmd = [ns.analyzer, os.path.abspath(ns.audio),
           "--out", os.path.abspath(out)]
    proc = subprocess.run(cmd, env=env, capture_output=True, text=True)
    err = (proc.stderr or "").strip().splitlines()
    print(err[-1] if err else f"wrote {out}")
    return proc.returncode


HISTORY_MAX = 20


def history_push(path, doc):
    hist = path + ".history"
    stack = []
    if os.path.isfile(hist):
        try:
            with open(hist) as fh:
                stack = json.load(fh)
        except (json.JSONDecodeError, OSError):
            stack = []
    stack.append(doc)
    with open(hist, "w") as fh:
        json.dump(stack[-HISTORY_MAX:], fh)


def cmd_undo(argv):
    if len(argv) < 3:
        print("usage: agent/mashpit undo <arrangement.json>")
        return 2
    path = argv[2]
    hist = path + ".history"
    if not os.path.isfile(hist):
        print("nothing to undo")
        return 1
    with open(hist) as fh:
        stack = json.load(fh)
    if not stack:
        print("nothing to undo")
        return 1
    prev = stack.pop()
    with open(hist, "w") as fh:
        json.dump(stack, fh)
    with open(path, "w") as fh:
        json.dump(prev, fh, indent=2)
    print(f"undone: {path} restored ({len(stack)} steps left)")
    return 0


def describe_diff(old, new):
    lines = []
    if old.get("projectBpm") != new.get("projectBpm"):
        lines.append(f"projectBpm {old.get('projectBpm')} -> {new.get('projectBpm')}")
    old_clips = {c.get("track"): c for c in old.get("clips", [])}
    for c in new.get("clips", []):
        o = old_clips.get(c.get("track"), {})
        for k in ("tempoRatio", "pitchSemi", "atBar", "bars"):
            if o.get(k) != c.get(k):
                lines.append(f"clip {c.get('track')}.{k}: {o.get(k)} -> {c.get(k)}")
    if old.get("mix") != new.get("mix"):
        lines.append(f"mix: {old.get('mix')} -> {new.get('mix')}")
    return lines or ["(no changes)"]


def cmd_edit(argv):
    import argparse
    import copy
    ap = argparse.ArgumentParser(prog="agent/mashpit edit")
    ap.add_argument("arrangement")
    ap.add_argument("--op", required=True, choices=("match_bpm", "smooth"))
    ap.add_argument("--track", default=None)
    ap.add_argument("--at", type=float, default=None, help="seconds (smooth)")
    ap.add_argument("--bars", type=int, default=8)
    ap.add_argument("--dry-run", action="store_true")
    ns = ap.parse_args(argv[2:])

    doc, error = load_doc(ns.arrangement)
    if error:
        print(error)
        return 2
    problems = validate(doc)
    if problems:
        print("fix validation first:")
        for kind, msg in problems:
            print(f"  [{kind}] {msg}")
        return 1
    basedir = os.path.dirname(os.path.abspath(ns.arrangement))
    new = copy.deepcopy(doc)

    if ns.op == "match_bpm":
        targets = [c for c in new["clips"]
                   if ns.track is None or c.get("track") == ns.track]
        if not targets:
            print(f"no clips match track '{ns.track}'")
            return 1
        for c in targets:
            tid = c["track"]
            audio = next(t["file"] for t in new["tracks"] if t["id"] == tid)
            if not os.path.isabs(audio):
                audio = os.path.join(basedir, audio)
            sc, serr = sidecar_for(audio)
            if serr:
                print(serr)
                return 1
            ratio = round(new["projectBpm"] / sc["bpm"], 4)
            c["tempoRatio"] = ratio
            print(f"{tid}: file {sc['bpm']}bpm -> ratio {ratio} (keylock on assumed)")
    elif ns.op == "smooth":
        if ns.at is None:
            print("--op smooth needs --at SECONDS")
            return 2
        spb = sec_per_bar(new["projectBpm"])
        at_bar = round(ns.at / spb) + 1
        entry = {"atBar": at_bar, "bars": ns.bars, "xfade": "equal-power"}
        if new["mix"]:
            new["mix"][0].update(entry)
            print(f"xfade widened to {ns.bars} bars @bar {at_bar}")
        else:
            new["mix"].append(entry)
            print(f"xfade written: {ns.bars} bars @bar {at_bar}")

    for line in describe_diff(doc, new):
        print(f"  diff {line}")
    if ns.dry_run:
        print("(dry run — arrangement untouched)")
        return 0
    history_push(ns.arrangement, doc)
    with open(ns.arrangement, "w") as fh:
        json.dump(new, fh, indent=2)
    print(f"wrote {ns.arrangement}")
    return 0


def cmd_snippet(argv):
    import argparse
    import wave
    ap = argparse.ArgumentParser(prog="agent/mashpit snippet")
    ap.add_argument("arrangement")
    ap.add_argument("--from-sec", type=float, required=True)
    ap.add_argument("--to-sec", type=float, required=True)
    ap.add_argument("--out", default=None)
    ap.add_argument("--tier", default="preview")
    ap.add_argument("--driver", default=os.environ.get("MASHPT_OFFLINE_DRIVER"))
    ns = ap.parse_args(argv[2:])
    if ns.to_sec <= ns.from_sec:
        print("--to-sec must be after --from-sec")
        return 2
    # full preview render, then slice (stdlib wave only — no numpy needed)
    full = os.path.join("/tmp/opencode", "mashpit-snippet-full.wav")
    render_argv = ["mashpit", "render", ns.arrangement, "--tier", ns.tier,
                   "--out", full]
    if ns.driver:
        render_argv += ["--driver", ns.driver]
    rc = cmd_render(render_argv)
    if rc != 0:
        return rc
    out = ns.out or "snippet.wav"
    with wave.open(full, "rb") as w:
        sr, n = w.getframerate(), w.getnframes()
        raw = w.readframes(n)
        ch, sw = w.getnchannels(), w.getsampwidth()
    a, b = int(ns.from_sec * sr), int(ns.to_sec * sr)
    frame_bytes = ch * sw
    with wave.open(out, "wb") as w:
        w.setnchannels(ch)
        w.setsampwidth(sw)
        w.setframerate(sr)
        w.writeframes(raw[a * frame_bytes:b * frame_bytes])
    print(f"wrote {out} ({ns.from_sec}-{ns.to_sec}s)")
    return 0


def cmd_qc(argv):
    import argparse
    import struct
    import wave
    ap = argparse.ArgumentParser(prog="agent/mashpit qc")
    ap.add_argument("wav")
    ns = ap.parse_args(argv[2:])
    with wave.open(ns.wav, "rb") as w:
        n, sr, ch, sw = w.getnframes(), w.getframerate(), w.getnchannels(), w.getsampwidth()
        raw = w.readframes(n)
    fmt = "<%dh" % (n * ch) if sw == 2 else "<%df" % (n * ch)
    try:
        vals = struct.unpack(fmt, raw[: n * ch * sw])
    except struct.error:
        print("qc: unsupported sample width (need 16-bit PCM or float32)")
        return 2
    peak = max(abs(v) for v in vals) / (32768 if sw == 2 else 1.0)
    clipped = sum(1 for v in vals if abs(v) >= (32767 if sw == 2 else 1.0)) / len(vals)
    win = sr  # 1s windows for silence scan
    silent = sum(1 for i in range(0, len(vals), win)
                 if max(abs(v) for v in vals[i:i + win]) < (200 if sw == 2 else 0.006))
    mean_sq = sum((v / (32768 if sw == 2 else 1.0)) ** 2 for v in vals) / len(vals)
    import math
    rms_db = 10 * math.log10(mean_sq + 1e-12)
    print(f"qc {ns.wav}: {n / sr:.1f}s peak={peak:.3f} "
          f"clipped={clipped * 100:.2f}% silent_windows={silent} rms={rms_db:.1f}dB")
    bad = []
    if clipped > 0.001:
        bad.append("clipping — pull gains down")
    if peak < 0.1:
        bad.append("very quiet — check gains/mutes")
    print("qc " + ("FAIL: " + "; ".join(bad) if bad else "PASS"))
    return 1 if bad else 0


def bar_to_sec(bar, spb):
    return (bar - 1) * spb


def run_driver(driver, args, workdir):
    print("  $ offline-driver " + " ".join(args))
    env = dict(os.environ)
    env["QT_QPA_PLATFORM"] = "offscreen"
    proc = subprocess.run([driver] + args, cwd=workdir, env=env,
                          capture_output=True, text=True)
    for line in (proc.stderr or "").strip().splitlines()[-4:]:
        print(f"    | {line}")
    return proc.returncode


def cmd_render(argv):
    import argparse  # local import: keeps `validate` dependency-free
    ap = argparse.ArgumentParser(prog="agent/mashpit render")
    ap.add_argument("arrangement")
    ap.add_argument("--tier", default="preview", choices=("preview", "full"))
    ap.add_argument("--out", default=None)
    ap.add_argument("--driver", default=os.environ.get("MASHPT_OFFLINE_DRIVER"))
    ap.add_argument("--frames", type=int, default=256)
    ap.add_argument("--workdir", default="/tmp/opencode/mashpit-render")
    ns = ap.parse_args(argv[2:])

    doc, error = load_doc(ns.arrangement)
    if error:
        print(error)
        return 2
    problems = validate(doc)
    if problems:
        print(f"invalid: {ns.arrangement} ({len(problems)} problems, fix first)")
        for kind, msg in problems:
            print(f"  [{kind}] {msg}")
        return 1
    if not ns.driver or not os.path.isfile(ns.driver):
        print("need the OfflineDriver binary: set MASHPT_OFFLINE_DRIVER "
              "(glue/offline_driver.cpp, built via MASHPT_GLUE_DIR)")
        return 2
    clips = doc["clips"]
    if not 1 <= len(clips) <= 2:
        print("render v1 supports 1-2 clips "
              f"(got {len(clips)} — DjDeckTrack multideck lands later)")
        return 2
    if clips[0].get("atBar", 1) != 1:
        print("render v1 needs the first clip at bar 1 "
              "(clip offsets beyond B land with DjDeckTrack)")
        return 2
    basedir = os.path.dirname(os.path.abspath(ns.arrangement))
    bpm = doc["projectBpm"]
    spb = sec_per_bar(bpm)
    track_file = {}
    for t in doc["tracks"]:
        p = t["file"]
        if not os.path.isabs(p):
            p = os.path.join(basedir, p)
        track_file[t["id"]] = p
    for tid, p in track_file.items():
        if not os.path.isfile(p):
            print(f"missing audio file for track '{tid}': {p}")
            return 2
    os.makedirs(ns.workdir, exist_ok=True)
    out = ns.out or os.path.join(ns.workdir, "mash.wav")
    frames = ns.frames
    if frames % 2:
        print("frames must be even (stereo SAMPLES units downstream)")
        return 2

    def clip_end(c):
        return bar_to_sec(c["atBar"] + c["bars"], spb)

    if doc["mix"]:
        mx = doc["mix"][0]
        total = max(clip_end(c) for c in clips) + 2.0
        blocks = math.ceil(total * ENGINE_SR / frames) + 8
        a, b = clips[0], clips[1] if len(clips) > 1 else None
        cmd = ["--a", track_file[a["track"]], "--out", out,
               "--blocks", str(blocks), "--frames", str(frames),
               "--a-ratio", str(a.get("tempoRatio", 1.0)),
               "--a-key", str(a.get("pitchSemi", 0)),
               "--bpm", str(bpm), "--tier", ns.tier]
        if b is not None:
            cmd += ["--b", track_file[b["track"]],
                    "--b-ratio", str(b.get("tempoRatio", 1.0)),
                    "--b-key", str(b.get("pitchSemi", 0)),
                    "--b-offset", str(bar_to_sec(b["atBar"], spb)),
                    "--xfade-at", str(bar_to_sec(mx["atBar"], spb)),
                    "--xfade-bars", str(mx["bars"])]
        else:
            cmd += ["--b", track_file[a["track"]], "--b-gain", "0"]
        rc = run_driver(ns.driver, cmd, ns.workdir)
        print(f"wrote {out}" if rc == 0 else "render FAILED")
        return rc

    # layered path: solo passes + numpy mixdown
    import numpy as np  # noqa: E402
    roles = {t["id"]: t.get("role", "other") for t in doc["tracks"]}
    stems = []
    for i, c in enumerate(clips):
        stem_wav = os.path.join(ns.workdir, f"stem{i}.wav")
        total = clip_end(c) + 1.0
        blocks = math.ceil(total * ENGINE_SR / frames) + 8
        cmd = ["--a", track_file[c["track"]], "--b", track_file[c["track"]],
               "--out", stem_wav, "--blocks", str(blocks), "--frames", str(frames),
               "--a-ratio", str(c.get("tempoRatio", 1.0)),
               "--a-key", str(c.get("pitchSemi", 0)),
               "--a-only", "--tier", ns.tier]
        rc = run_driver(ns.driver, cmd, ns.workdir)
        if rc != 0:
            print("render FAILED")
            return rc
        stems.append((stem_wav, c))
    import wave
    mixed, sr = None, ENGINE_SR
    for stem_wav, c in stems:
        with wave.open(stem_wav, "rb") as w:
            n = w.getnframes()
            x = (np.frombuffer(w.readframes(n), dtype="<i2").astype(np.float32)
                 / 32768).reshape(-1, 2)
        gain_db = 6.0 if roles.get(c["track"]) == "vocal" else 0.0
        x = x * (10 ** (gain_db / 20))
        start = int(bar_to_sec(c["atBar"], spb) * sr)
        need = start + len(x)
        if mixed is None or len(mixed) < need:
            pad = np.zeros((max(0, need - (len(mixed) if mixed is not None else 0)), 2),
                           dtype=np.float32)
            mixed = pad if mixed is None else np.vstack([mixed, pad])
        if c["atBar"] > 1:
            fin = min(int(2 * sr), len(x))
            x[:fin] *= (0.5 - 0.5 * np.cos(np.linspace(0, np.pi, fin)))[:, None]
        mixed[start:start + len(x)] += x
    fout = int(4 * sr)
    mixed[-fout:] *= (0.5 + 0.5 * np.cos(np.linspace(0, np.pi, fout)))[:, None]
    mixed /= max(1e-9, np.abs(mixed).max())
    mixed *= 0.89
    with wave.open(out, "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes((np.clip(mixed, -1, 1) * 32767).astype("<i2").tobytes())
    print(f"wrote {out} ({len(mixed) / sr:.1f}s, layered {len(stems)} stems)")
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip().splitlines()[0])
        print("usage: agent/mashpit (validate|render|analyze|edit|snippet|qc|undo) ...")
        return 2
    cmds = {"validate": cmd_validate, "render": cmd_render,
            "analyze": cmd_analyze, "edit": cmd_edit,
            "snippet": cmd_snippet, "qc": cmd_qc, "undo": cmd_undo}
    if argv[1] in cmds:
        return cmds[argv[1]](argv)
    print(f"unknown command '{argv[1]}' (validate|render|analyze|edit|snippet|qc|undo)")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
